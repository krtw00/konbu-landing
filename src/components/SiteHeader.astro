---
const navLinks = [
  { href: '/#features', label: '機能' },
  { href: '/#plans', label: 'プラン' },
  { href: '/billing', label: '料金と返金' },
  { href: '/contact', label: 'お問い合わせ' },
]
---

<header class="fixed top-0 z-50 w-full border-b border-[#C4D9D5]/60 bg-[#F2F8F7]/85 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2">
      <img src="/favicon.svg" alt="konbu" class="h-6 w-6" />
      <span class="text-lg font-semibold" style="color: #1A3A34;">konbu</span>
    </a>
    <nav class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium transition-colors hover:opacity-80" style="color: #587D75;">
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href="https://konbu-cloud.codenica.dev"
      class="rounded-md px-4 py-1.5 text-sm font-medium text-white transition-colors"
      style="background-color: #0D9488;"
      onmouseover="this.style.backgroundColor='#0B7F74'"
      onmouseout="this.style.backgroundColor='#0D9488'"
    >
      クラウド版を開く
    </a>
  </div>
</header>
