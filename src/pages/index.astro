---
import Layout from '../layouts/Layout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

const paidFeatures = [
  'AIアシスタント',
  '画像添付',
  'API / CLI / MCP 連携',
  '自分の AI API キー設定',
]

const freeFeatures = [
  'カレンダー',
  'メモ',
  'ToDo',
  '横断検索',
  'ブックマーク',
]
---

<Layout
  title="konbu — CLI/MCP対応のAIプランナー"
  description="Notion + Todoist + Calendar をひとつにまとめた、セルフホスト可能なAIプランナー。Claude/CursorからMCPで直接操作。無料プランと有料 konbu Pro。"
  path="/"
>
  <SiteHeader />

  <section class="px-6 pb-20 pt-32">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em]" style="color: #0D9488;">
          CLI · MCP · セルフホスト · AIネイティブ
        </p>
        <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl" style="color: #1A3A34;">
          開発者ツールのように
          <br />
          作られたオンライン手帳。
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8" style="color: #587D75;">
          konbu は、Notion + Todoist + Calendar をひとつにまとめた、
          セルフホスト可能なオンライン手帳です。
          Claude、Cursor、その他のMCPクライアントから直接操作できる、OSS・AIネイティブな設計。
          有料プラン
          <strong style="color: #1A3A34;"> konbu Pro </strong>
          ではAI機能・画像添付・API / CLI / MCP 連携が利用できます。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="https://konbu-cloud.codenica.dev"
            class="inline-flex items-center rounded-lg px-7 py-3 text-base font-medium text-white transition-colors"
            style="background-color: #0D9488;"
            onmouseover="this.style.backgroundColor='#0B7F74'"
            onmouseout="this.style.backgroundColor='#0D9488'"
          >
            無料で始める
          </a>
          <a
            href="#plans"
            class="inline-flex items-center rounded-lg border px-7 py-3 text-base font-medium transition-colors hover:bg-white"
            style="border-color: #C4D9D5; color: #1A3A34;"
          >
            プランを見る
          </a>
        </div>
        <dl class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border p-4" style="border-color: #C4D9D5; background-color: #FAFFFE;">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em]" style="color: #8BACA5;">提供形態</dt>
            <dd class="mt-2 text-sm font-medium" style="color: #1A3A34;">Web アプリ / SaaS</dd>
          </div>
          <div class="rounded-2xl border p-4" style="border-color: #C4D9D5; background-color: #FAFFFE;">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em]" style="color: #8BACA5;">無料プラン</dt>
            <dd class="mt-2 text-sm font-medium" style="color: #1A3A34;">あり</dd>
          </div>
          <div class="rounded-2xl border p-4" style="border-color: #C4D9D5; background-color: #FAFFFE;">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em]" style="color: #8BACA5;">決済の用途</dt>
            <dd class="mt-2 text-sm font-medium" style="color: #1A3A34;">Pro 機能の利用料金</dd>
          </div>
        </dl>
      </div>

      <div class="grid gap-6">
        <img src="/hero-chat.png" alt="konbu AI アシスタント画面" class="rounded-[28px] shadow-xl" style="border: 1px solid #C4D9D5;" />
        <img src="/hero.png" alt="konbu のカレンダーとワークスペース" class="rounded-[28px] shadow-xl" style="border: 1px solid #C4D9D5;" />
      </div>
    </div>
  </section>

  <section class="px-6 py-16" style="background-color: #FAFFFE;">
    <div class="mx-auto max-w-6xl rounded-[32px] border p-8 sm:p-10" style="border-color: #C4D9D5;">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em]" style="color: #0D9488;">販売しているもの</p>
          <h2 class="mt-3 text-3xl font-bold" style="color: #1A3A34;">デジタル機能へのアクセスを販売しています</h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl p-5" style="background-color: #F2F8F7;">
            <h3 class="font-semibold" style="color: #1A3A34;">対象サービス</h3>
            <p class="mt-2 text-sm leading-6" style="color: #587D75;">
              konbu Free と konbu Pro。どちらもオンラインで提供するソフトウェアです。
            </p>
          </div>
          <div class="rounded-2xl p-5" style="background-color: #F2F8F7;">
            <h3 class="font-semibold" style="color: #1A3A34;">決済の性質</h3>
            <p class="mt-2 text-sm leading-6" style="color: #587D75;">
              寄付やチップではなく、定義されたプレミアム機能の利用料金です。
            </p>
          </div>
          <div class="rounded-2xl p-5" style="background-color: #F2F8F7;">
            <h3 class="font-semibold" style="color: #1A3A34;">提供内容</h3>
            <p class="mt-2 text-sm leading-6" style="color: #587D75;">
              AIチャット、画像添付、API / CLI / MCP 連携など、アプリ内機能へのアクセスを提供します。
            </p>
          </div>
          <div class="rounded-2xl p-5" style="background-color: #F2F8F7;">
            <h3 class="font-semibold" style="color: #1A3A34;">含まれないもの</h3>
            <p class="mt-2 text-sm leading-6" style="color: #587D75;">
              第三者のための決済代行、送金、クラウドファンディング、慈善寄付の受付は行いません。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl font-bold" style="color: #1A3A34;">主要機能</h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-base leading-7" style="color: #587D75;">
        スケジュールを中心に据えながら、メモやタスクを別アプリに散らさず扱える構成です。
      </p>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-[28px] border p-8 sm:col-span-2 lg:col-span-3" style="background-color: #FAFFFE; border-color: #0D9488;">
          <h3 class="text-lg font-semibold" style="color: #1A3A34;">AIアシスタント</h3>
          <p class="mt-3 text-sm leading-7" style="color: #587D75;">
            「明日の予定を見せて」「このメモを探して」「来週の空きに予定を入れて」と自然文で操作できます。
          </p>
        </div>
        <div class="rounded-[28px] border p-8" style="background-color: #FAFFFE; border-color: #C4D9D5;">
          <h3 class="text-lg font-semibold" style="color: #1A3A34;">カレンダー</h3>
          <p class="mt-3 text-sm leading-7" style="color: #587D75;">月表示を軸に予定を管理。毎日の確認と登録がひとつの画面で完結します。</p>
        </div>
        <div class="rounded-[28px] border p-8" style="background-color: #FAFFFE; border-color: #C4D9D5;">
          <h3 class="text-lg font-semibold" style="color: #1A3A34;">ToDo</h3>
          <p class="mt-3 text-sm leading-7" style="color: #587D75;">予定に乗らないタスクも同じ場所で管理。日付やメモもそのまま残せます。</p>
        </div>
        <div class="rounded-[28px] border p-8" style="background-color: #FAFFFE; border-color: #C4D9D5;">
          <h3 class="text-lg font-semibold" style="color: #1A3A34;">メモ</h3>
          <p class="mt-3 text-sm leading-7" style="color: #587D75;">予定に紐づくメモも、独立したノートも、同じワークスペースに保存できます。</p>
        </div>
        <div class="rounded-[28px] border p-8" style="background-color: #FAFFFE; border-color: #C4D9D5;">
          <h3 class="text-lg font-semibold" style="color: #1A3A34;">ブックマーク</h3>
          <p class="mt-3 text-sm leading-7" style="color: #587D75;">よく使う URL や業務リンクも、予定の近くに置いたまま使えます。</p>
        </div>
        <div class="rounded-[28px] border p-8" style="background-color: #FAFFFE; border-color: #C4D9D5;">
          <h3 class="text-lg font-semibold" style="color: #1A3A34;">横断検索</h3>
          <p class="mt-3 text-sm leading-7" style="color: #587D75;">予定・メモ・ToDo・リンクをまとめて検索。保存先を思い出す必要がありません。</p>
        </div>
      </div>
    </div>
  </section>

  <section id="plans" class="px-6 py-24" style="background-color: #FAFFFE;">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em]" style="color: #0D9488;">Plans</p>
        <h2 class="mt-3 text-3xl font-bold" style="color: #1A3A34;">無料プランと有料プランを提供しています</h2>
        <p class="mt-4 text-base leading-7" style="color: #587D75;">
          有料プランはソフトウェア機能の利用料金です。寄付、チップ、クラウドファンディング支援ではありません。
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[32px] border p-8" style="border-color: #C4D9D5; background-color: #F2F8F7;">
          <div class="flex items-center justify-between">
            <h3 class="text-2xl font-semibold" style="color: #1A3A34;">konbu Free</h3>
            <span class="rounded-full px-3 py-1 text-xs font-semibold uppercase" style="background-color: #E6F0EE; color: #0D9488;">Free</span>
          </div>
          <p class="mt-4 text-sm leading-7" style="color: #587D75;">
            基本的なワークスペース機能を無料で利用できます。登録後すぐに使い始められます。
          </p>
          <ul class="mt-6 space-y-3 text-sm" style="color: #1A3A34;">
            {freeFeatures.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-[#0D9488]">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-[32px] border p-8" style="border-color: #0D9488; background-color: #FAFFFE;">
          <div class="flex items-center justify-between">
            <h3 class="text-2xl font-semibold" style="color: #1A3A34;">konbu Pro</h3>
            <span class="rounded-full px-3 py-1 text-xs font-semibold uppercase text-white" style="background-color: #0D9488;">Paid</span>
          </div>
          <div class="mt-4 flex items-end gap-3">
            <div class="text-3xl font-bold" style="color: #1A3A34;">¥980</div>
            <div class="pb-1 text-sm" style="color: #587D75;">/ 月</div>
          </div>
          <p class="mt-2 text-sm leading-7" style="color: #587D75;">
            年額は <strong style="color: #1A3A34;">¥9,800 / 年</strong>。月額換算で約 17% お得です。
          </p>
          <p class="mt-4 text-sm leading-7" style="color: #587D75;">
            AI と外部連携を中心としたプレミアム機能を追加します。購入画面では請求間隔と更新条件を明示します。
          </p>
          <ul class="mt-6 space-y-3 text-sm" style="color: #1A3A34;">
            {paidFeatures.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-[#0D9488]">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 rounded-2xl p-4 text-sm leading-7" style="background-color: #F2F8F7; color: #587D75;">
            決済は konbu Pro のアクセス料金にのみ使用されます。第三者のための送金、資金保管、決済代行には使用しません。
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://konbu-cloud.codenica.dev"
          class="inline-flex items-center rounded-lg px-7 py-3 text-base font-medium text-white transition-colors"
          style="background-color: #0D9488;"
          onmouseover="this.style.backgroundColor='#0B7F74'"
          onmouseout="this.style.backgroundColor='#0D9488'"
        >
          クラウド版で確認する
        </a>
        <a href="/billing" class="text-sm font-medium underline-offset-4 hover:underline" style="color: #1A3A34;">
          料金・返金・解約ポリシーを見る
        </a>
      </div>
    </div>
  </section>

  <section class="px-6 py-24">
    <div class="mx-auto max-w-6xl rounded-[32px] border p-8 sm:p-10" style="border-color: #C4D9D5; background-color: #FAFFFE;">
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em]" style="color: #0D9488;">Policies</p>
          <h2 class="mt-3 text-3xl font-bold" style="color: #1A3A34;">購入前に確認できる情報</h2>
          <p class="mt-4 text-base leading-7" style="color: #587D75;">
            お問い合わせ、プライバシー、利用規約、料金・返金・解約ポリシーを公開しています。
            Stripe での決済前に、提供内容とルールを確認できます。
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/privacy" class="rounded-2xl border p-5 transition-colors hover:bg-[#F2F8F7]" style="border-color: #C4D9D5;">
            <div class="font-semibold" style="color: #1A3A34;">プライバシーポリシー</div>
            <div class="mt-2 text-sm leading-6" style="color: #587D75;">収集する情報、利用目的、保存と削除について。</div>
          </a>
          <a href="/terms" class="rounded-2xl border p-5 transition-colors hover:bg-[#F2F8F7]" style="border-color: #C4D9D5;">
            <div class="font-semibold" style="color: #1A3A34;">利用規約</div>
            <div class="mt-2 text-sm leading-6" style="color: #587D75;">サービス利用条件、禁止事項、アカウント運用について。</div>
          </a>
          <a href="/billing" class="rounded-2xl border p-5 transition-colors hover:bg-[#F2F8F7]" style="border-color: #C4D9D5;">
            <div class="font-semibold" style="color: #1A3A34;">料金・返金・解約</div>
            <div class="mt-2 text-sm leading-6" style="color: #587D75;">有料プランの請求、解約、返金申請の取り扱い。</div>
          </a>
          <a href="/contact" class="rounded-2xl border p-5 transition-colors hover:bg-[#F2F8F7]" style="border-color: #C4D9D5;">
            <div class="font-semibold" style="color: #1A3A34;">お問い合わせ</div>
            <div class="mt-2 text-sm leading-6" style="color: #587D75;">サポートフォームと一般的な問い合わせ窓口。</div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 py-24" style="background-color: #FAFFFE;">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold" style="color: #1A3A34;">今すぐ konbu を試す</h2>
      <p class="mt-4 text-base leading-7" style="color: #587D75;">
        無料プランから始められます。アカウント作成後に、有料プランの内容と料金を確認できます。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="https://konbu-cloud.codenica.dev"
          class="inline-flex items-center rounded-lg px-8 py-3.5 text-base font-medium text-white transition-colors"
          style="background-color: #0D9488;"
          onmouseover="this.style.backgroundColor='#0B7F74'"
          onmouseout="this.style.backgroundColor='#0D9488'"
        >
          無料で始める
        </a>
        <a href="/contact" class="inline-flex items-center rounded-lg border px-8 py-3.5 text-base font-medium transition-colors hover:bg-white" style="border-color: #C4D9D5; color: #1A3A34;">
          お問い合わせ
        </a>
      </div>
    </div>
  </section>

  <SiteFooter />
</Layout>
